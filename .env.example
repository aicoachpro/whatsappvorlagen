# WhatsAppVorlagen SuperChat — Umgebungsvariablen
# NIEMALS echte Keys committen — nur in .env eintragen

# Linear
LINEAR_API_KEY=your_linear_api_key_here
LINEAR_WEBHOOK_SECRET=your_webhook_secret_here

# Notion
NOTION_TOKEN=your_notion_integration_token_here
# Database "Whatsapp Vorlagen" (CRM & Sales Hub > Superchat Workflows > Vorlagen Repository)
NOTION_DATABASE_ID=13ae35a1-94de-8026-b54e-c44acb42b3a5
NOTION_DATA_SOURCE_ID=d9c28910-c204-46ac-84c0-57422a89074d

# Superchat (WhatsApp Business Solution Provider)
# Doku: https://developers.superchat.com
SUPERCHAT_API_KEY=your_superchat_api_key_here
SUPERCHAT_INBOX_ID=your_inbox_id_here
# SUPERCHAT_BASE_URL=https://api.superchat.com  # nur wenn nicht Default

# GitHub
# SSH Key wird empfohlen statt Token

# Optional: Telegram Alerts
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Optional: Research
# OPENROUTER_API_KEY=

# Optional: Miro
# MIRO_ACCESS_TOKEN=

# Daemon (verhindert Claude Code nested session Probleme)
# CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
