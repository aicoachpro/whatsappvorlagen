# WhatsAppVorlagen SuperChat — Umgebungsvariablen
# NIEMALS echte Keys committen — nur in .env eintragen

# Linear
LINEAR_API_KEY=your_linear_api_key_here
LINEAR_WEBHOOK_SECRET=your_webhook_secret_here

# Notion
NOTION_TOKEN=your_notion_integration_token_here
# Database "Whatsapp Vorlagen autoabgleich" (CRM & Sales Hub > Superchat Workflows > Vorlagen Repository)
NOTION_DATABASE_ID=07ee35a1-94de-82d2-8748-81c0763b26df
NOTION_DATA_SOURCE_ID=c1ce35a1-94de-8215-be2f-874936629ea4

# Superchat (WhatsApp Business Solution Provider)
# Doku: https://developers.superchat.com
# Base-URL: https://api.superchat.com/v1.0
# Auth-Header: "X-API-Key: <key>"  (NICHT Bearer)
SUPERCHAT_API_KEY=your_superchat_api_key_here
SUPERCHAT_INBOX_ID=your_inbox_id_here
# SUPERCHAT_BASE_URL=https://api.superchat.com/v1.0  # nur ueberschreiben wenn noetig

# GitHub
# SSH Key wird empfohlen statt Token

# Optional: Telegram Alerts
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Optional: Research
# OPENROUTER_API_KEY=

# Optional: Miro
# MIRO_ACCESS_TOKEN=

# Daemon (verhindert Claude Code nested session Probleme)
# CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
